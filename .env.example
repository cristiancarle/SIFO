# Copiar a .env (NUNCA subir .env a git) o cargar en el panel del hosting.

# Clave para firmar las cookies de sesión. Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SIFO_SECRET_KEY=

# Administrador inicial (se crea o actualiza al arrancar).
SIFO_ADMIN_USUARIO=admin
# Usar UNA de las dos: la clave en texto o su hash (más seguro). Hash:
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('MI-CLAVE'))"
SIFO_ADMIN_CLAVE=
SIFO_ADMIN_CLAVE_HASH=

# 1 = cualquiera puede solicitar cuenta (queda pendiente de aprobación). 0 = registro cerrado.
SIFO_REGISTRO=1

# 1 en producción (cookies solo por HTTPS, HSTS, proxy del hosting).
SIFO_PRODUCCION=0
